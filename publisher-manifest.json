x solid var(--ink);background:var(--white);padding:24px 20px 26px;display:flex;flex-direction:column}\n  .plan.featured{background:var(--ink);color:var(--white)}\n  .plan .tag{align-self:flex-start;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;border:2px solid currentColor;padding:3px 9px;margin-bottom:14px}\n  .plan.featured .tag{color:#ffb8a6;border-color:#ffb8a6}\n  .plan h3{font-size:23px;margin-bottom:4px}\n  .plan .price{font-size:32px;font-weight:800;letter-spacing:-.02em;line-height:1.2;margin:6px 0 2px}\n  .plan .annual{font-size:13px;color:var(--gray);margin:0 0 18px}\n  .plan.featured .annual{color:#b9b9b9}\n  .plan ul{list-style:none;margin:0;padding:16px 0 0;border-top:1px solid var(--line);font-size:14.5px}\n  .plan.featured ul{border-top-color:#4a4a4a}\n  .plan ul li{padding-left:16px;position:relative;margin-bottom:10px;line-height:1.6}\n  .plan ul li::before{content:\"\";position:absolute;left:0;top:.62em;width:7px;height:7px;background:var(--accent)}\n  .plan.featured ul li::before{background:#ffb8a6}\n\n  /* 客户端区块 */\n  .clients{display:grid;gap:16px;grid-template-columns:1fr}\n  .client{border:2px solid var(--ink);background:var(--white);padding:20px}\n  .client p{margin:0 0 10px;font-size:14.5px;color:var(--ink-soft)}\n  .client .meta{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:700}\n\n  /* FAQ 对话气泡 */\n  .qa{display:grid;gap:20px;grid-template-columns:1fr}\n  .qa-item{display:flex;flex-direction:column;gap:8px}\n  .bubble-q{border:2px solid var(--ink);background:var(--white);padding:14px 16px;font-weight:700;font-size:15.5px;align-self:flex-start;max-width:100%;position:relative}\n  .bubble-q::after{content:\"\";position:absolute;left:26px;bottom:-9px;width:14px;height:14px;background:var(--white);border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:rotate(45deg)}\n  .bubble-a{background:var(--white);border-left:5px solid var(--accent);padding:14px 16px;font-size:15px;color:var(--ink-soft);margin-left:14px}\n  .bubble-a p{margin:0 0 8px}\n  .bubble-a p:last-child{margin-bottom:0}\n\n  .closing{padding:54px 22px 70px;background:var(--ink);color:#e9e9e9;font-size:14.5px}\n  .closing strong{color:var(--white);display:block;font-size:17px;margin-bottom:10px}\n  .closing p{margin:0 0 12px;max-width:38em}\n  .closing a{color:#ffb8a6;border-bottom-color:#7a4438}\n\n  @media (min-width:760px){\n    .hero-grid{display:grid;grid-template-columns:1.55fr 1fr;gap:40px;align-items:end}\n    .hero-side{border-top:none;border-left:2px solid var(--ink);margin-top:0;padding:4px 0 4px 20px}\n    .steps{grid-template-columns:repeat(2,1fr)}\n    .clients{grid-template-columns:repeat(2,1fr)}\n    .qa{grid-template-columns:repeat(2,1fr);gap:28px 32px}\n    .plans{grid-template-columns:repeat(2,1fr)}\n    .plan.featured{grid-column:span 2}\n  }\n\n  @media (min-width:1000px){\n    .sidenav{display:block}\n    .content{margin-left:210px}\n    .band,section,.closing{padding-left:54px;padding-right:54px}\n    section{padding-top:76px;padding-bottom:76px}\n    .plans{grid-template-columns:repeat(3,1fr)}\n    .plan.featured{grid-column:auto}\n    .steps{grid-template-columns:repeat(4,1fr)}\n  }\n</style><div class=\"layout\">\n\n  <nav class=\"sidenav\" aria-label=\"页面目录\">\n    <div class=\"sidenav-inner\">\n      <div>\n        <p class=\"mark\">白嫖<span>GALAXY</span></p>\n        <ol>\n          <li><a href=\"#top\">从这一页开始</a></li>\n          <li><a href=\"#how\">怎么开始用</a></li>\n          <li><a href=\"#plans\">套餐摆在一起看</a></li>\n          <li><a href=\"#clients\">客户端与设备</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ol>\n      </div>\n      <p class=\"foot\">页面内容随服务调整而更新。<br>价格与权益以本页正文为准。</p>\n    </div>\n  </nav>\n\n  <div class=\"content\" id=\"top\">\n    <main>\n\n      \n      <div class=\"band band-1\">\n        <p class=\"eyebrow\">白嫖 · Galaxy · 服务说明页</p>\n        <h1>白嫖(Galaxy)<span class=\"thin\">先看懂，再决定。价格、权益、步骤，全写在明面上。</span></h1>\n      </div>\n\n      <div class=\"band band-2\">\n        <div class=\"hero-grid\">\n          <p class=\"lede\">如果你只是想弄清楚这个服务到底提供什么、花多少钱、要动几步才能用上，那这一页就够了。我们把套餐摊开、把流程写细、把常见疑问按你可能会问的顺序排好，不绕弯子。</p>\n          <div class=\"hero-side\">\n            <dl>\n              <dt>档位</dt><dd>基础版 / 旗舰版 / 团队版</dd>\n              <dt>周期</dt><dd>月付与年付两种，年付更省</dd>\n              <dt>起步</dt><dd>选档 → 注册 → 配客户端</dd>\n              <dt>适合谁</dt><dd>个人日常使用，到小团队协同</dd>\n            </dl>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"band band-3\">\n        <div class=\"row\">\n          <div><strong>流量按月计</strong><span>每档各有月度流量额度，超出前本页不做承诺。</span></div>\n          <div><strong>设备数分开算</strong><span>同时在线设备数与档位绑定，团队版给到 20 台。</span></div>\n          <div><strong>支持按工单沟通</strong><span>旗舰版与团队版在支持队列上有不同排序。</span></div>\n        </div>\n      </div>\n\n      <div class=\"band band-4\">\n        一句话：不确定就挑中间那档。往前一步是更少的额度，往后一步是更多的人和设备。<a href=\"#plans\">直接看对照</a>\n      </div>\n\n      \n      <section id=\"how\">\n        <h2>怎么开始用</h2>\n        <p class=\"section-note\">四步，从看到这一步到真正跑起来。每步都不需要什么背景知识，按顺序做就行。</p>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <span class=\"num\">STEP 01</span>\n            <h3>先定档位</h3>\n            <p>数一下你平时要连几台设备、每月大概用掉多少流量，再回到套餐区对一眼。宁可留点余量，不要卡在边缘。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"num\">STEP 02</span>\n            <h3>注册并确认周期</h3>\n            <p>月付适合先试一段时间，年付适合你已经确定要长期用。两种周期的权益范围一致，区别在于计费方式。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"num\">STEP 03</span>\n            <h3>在你常用的设备上装客户端</h3>\n            <p>按你手上的系统选对应客户端，首次打开后按界面提示完成账号绑定。设备数上限按你的档位计算。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"num\">STEP 04</span>\n            <h3>跑通一次，再看细节</h3>\n            <p>确认能正常连上后，再去调路由、流媒体或游戏相关的偏好项。先能用，再好用，顺序别反。</p>\n          </article>\n        </div>\n      </section>\n\n      \n      <section id=\"plans\">\n        <h2>套餐摆在一起看</h2>\n        <p class=\"section-note\">三档价格与权益如下，年付价单独标在月付价下方。旗舰版被标为推荐，是因为它在流量、设备数与支持排序之间比较均衡，不是因为别的档位不好。</p>\n\n        <div class=\"plans\">\n          <article class=\"plan\">\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span> / 月</span></p>\n            <p class=\"annual\">按年付 ¥150 / 年</p>\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </article>\n\n          <article class=\"plan featured\">\n            <span class=\"tag\">推荐</span>\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35<span> / 月</span></p>\n            <p class=\"annual\">按年付 ¥350 / 年</p>\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线，游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n          </article>\n\n          <article class=\"plan\">\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span> / 月</span></p>\n            <p class=\"annual\">按年付 ¥850 / 年</p>\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理对接</li>\n            </ul>\n          </article>\n        </div>\n      </section>\n\n      \n      <section id=\"clients\">\n        <h2>客户端与设备</h2>\n        <p class=\"section-note\">客户端以你使用的系统为准。这里只说明各档位在设备侧的影响，不提供下载地址；具体安装方式请以你账号内的官方指引为准。</p>\n        <div class=\"clients\">\n          <article class=\"client\">\n            <p class=\"meta\">个人设备</p>\n            <h3>手机与电脑</h3>\n            <p>基础版可以同时在线 3 台，旗舰版 5 台。手机、平板、笔记本放在一起数，别漏算。</p>\n          </article>\n          <article class=\"client\">\n            <p class=\"meta\">家庭与多设备</p>\n            <h3>多人共用</h3>\n            <p>如果一台路由器下挂多个终端，建议先确认你的在线设备计数方式，再决定档位，免得中途卡在设备上限。</p>\n          </article>\n          <article class=\"client\">\n            <p class=\"meta\">小团队</p>\n            <h3>协同办公场景</h3>\n            <p>团队版给到 20 台同时在线与定制路由能力，配有专属客户经理，适合人数固定、设备清单明确的团队。</p>\n          </article>\n          <article class=\"client\">\n            <p class=\"meta\">进阶偏好</p>\n            <h3>线路与解锁</h3>\n            <p>对线路质量和流媒体解锁范围有要求的话，旗舰版及以上的权益描述更贴近这类需求。</p>\n          </article>\n        </div>\n      </section>\n\n      \n      <section id=\"faq\">\n        <h2>常见问题</h2>\n        <p class=\"section-note\">下面这些，是我们被问得最多的一批。我们尽量用聊天的语气回答，但内容都是实打实的。</p>\n\n        <div class=\"qa\">\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">我到底该选哪一档？</div>\n            <div class=\"bubble-a\">\n              <p>看两个数就行：你要同时连几台设备，每月大概用多少流量。3 台以内、用得不多，基础版够；设备多、还想要流媒体解锁和游戏线路优化，选旗舰版；固定的一群人一起用，看团队版。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">月付和年付差在哪？</div>\n            <div class=\"bubble-a\">\n              <p>权益范围一样，只是计费周期不同。年付价格更低，适合你已经确定要长期使用的情况；月付更灵活，方便你先观察一段时间再定。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">流量用超了会怎样？</div>\n            <div class=\"bubble-a\">\n              <p>本页只列出各档的月度流量额度，超出后的具体处理方式不在本页承诺范围内。建议你先按实际用量挑档，留出余量；如果长期接近上限，升级档位更直接。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">设备数是怎么算的？</div>\n            <div class=\"bubble-a\">\n              <p>按同时在线计算：同一时间连着的设备会计入你的档位上限。基础版 3 台、旗舰版 5 台、团队版 20 台。设备切下来就释放，不用手动去删。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">怎么装客户端？</div>\n            <div class=\"bubble-a\">\n              <p>按你手上的系统选对应客户端，正常安装后按界面提示绑定账号即可。本页不提供下载地址，请以你账号内的官方指引为准。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">出了问题找谁？</div>\n            <div class=\"bubble-a\">\n              <p>通过工单。旗舰版有 7×24 优先工单支持，团队版配专属客户经理。基础版同样可以提交工单，只是排队顺序不同。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">团队版里的“定制路由”指什么？</div>\n            <div class=\"bubble-a\">\n              <p>面向企业使用场景的路由配置能力。具体能配到什么程度，需要结合你的网络结构来谈，建议直接和专属客户经理沟通后再定。</p>\n            </div>\n          </div>\n\n          <div class=\"qa-item\">\n            <div class=\"bubble-q\">可以先小规模试一下吗？</div>\n            <div class=\"bubble-a\">\n              <p>最省事的做法是先按月付选一档，用一段时间，看设备和流量的实际占用，再决定要不要换档或改年付。换档前建议先对一眼套餐区。</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n    </main>\n\n    <footer class=\"closing\">\n      <strong>白嫖(Galaxy)</strong>\n      <p>这一页把价格、权益、步骤和常见疑问都摊开写了。如果你看完还有拿不准的地方，先按最接近你实际情况的那一档开始，用起来之后再调整，比反复对比更快。</p>\n      <p>页面内容可能随服务调整而更新；价格与权益以本页正文列出的为准。</p>\n    </footer>\n  </div>\n\n</div>",
